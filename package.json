{
  "name": "dsh-windows-notify",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 桌面通知插件：对话进入需要你操作的状态（命令/文件操作需要权限、AI 向你提问、回复完成、出错）时弹出 Windows 原生通知，点击通知回到 DSH；同时提供 AI 可调用的 notify_user 工具与 /plugins/dsh-windows-notify/send HTTP 接口。",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/airenburen/dsh-windows-notify.git"
  },
  "homepage": "https://github.com/airenburen/dsh-windows-notify#readme",
  "bugs": {
    "url": "https://github.com/airenburen/dsh-windows-notify/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "toast",
    "windows"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
